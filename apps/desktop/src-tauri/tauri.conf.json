{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Zin",
  "version": "0.1.0",
  "identifier": "ai.zin.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Zin",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../../../services/daemon/cmd/daemon/daemon"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
